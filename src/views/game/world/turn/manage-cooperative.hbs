{{#block "title"}}Coöperatie beheren{{/block}}

<!------------------------------------------------------------------------------------------------>

{{#block "headScripts"}}
<script type="module">
import { turn } from '/js/turn-check-access.js';
await turn.phase.checkAccess('manageCooperative');
</script>
{{/block}}

<!------------------------------------------------------------------------------------------------>

<form id="phase-form" class="d-none">
	<h1>Coöperatie beheren</h1>

	<div id="leave-section">
		<h2>🚪 Verlaten</h2>
		
		<div class="mt-md form-check">
			<input id="leave-action-input" class="form-check-input" type="checkbox">
			<label for="leave-action-input" class="form-check-label">
				<span id="cooperative-name-span"></span> verlaten
			</label>
		</div>
	</div>
	
	<h2>🤝 Toetreden</h2>
	
	<ul id="join-action-ul" class="list-compact d-none"></ul>
	
	<div class="mt-md">
		<button id="open-join-modal-button" class="btn btn--secondary" type="button" 
				data-bs-toggle="modal" data-bs-target="#join-modal">
			<span class="btn-front">Toetreden tot coöperatie...</span>
		</button>
	</div>
	
	<h2>🌱 Oprichten</h2>
	
	<ul id="found-action-ul" class="list-compact d-none"></ul>
	
	<div class="mt-md">
		<button id="open-found-modal-button" class="btn btn--secondary" type="button" 
				data-bs-toggle="modal" data-bs-target="#found-modal">
			<span class="btn-front">Coöperatie oprichten...</span>
		</button>
	</div>
	
	<div id="invite-section">
		<h2>✉️ Uitnodigen</h2>
		
		<p>Vrije plaatsen: <span id="free-slots-span"></span></p>
		
		<ul id="invite-actions-ul" class="list-compact d-none"></ul>
		
		<div class="mt-md">
			<button id="open-invite-modal-button" class="btn btn--secondary" type="button" 
					data-bs-toggle="modal" data-bs-target="#invite-modal">
				<span class="btn-front">Personage uitnodigen...</span>
			</button>
		</div>
	</div>
</form>

<!------------------------------------------------------------------------------------------------>

<div id="join-modal" class="modal fade" 
	 tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title">Toetreden tot coöperatie</h2>
				
				<button class="btn-close" type="button" 
						data-bs-dismiss="modal" aria-label="Sluiten"></button>
			</div>
			
			<form id="join-form" class="modal-body">
				<div class="stack">
					<div>
						<label for="method-select" class="form-label">
							Manier:
						</label>
						<select id="method-select" class="form-select" required>
							<option value="" selected disabled hidden>
								— kies een manier —
							</option>
							<option value="choose">
								Zelf kiezen
							</option>
							<option value="random">
								Willekeurig
							</option>
						</select>
					</div>
					
					<div id="join-name-div">
						<label for="join-name-input" class="form-label">
							Coöperatie:
						</label>
						<input id="join-name-input" class="form-control" type="text" required>
					</div>
				</div>
				
				<div id="join-name-error" class="mt-md error"></div>
				
				<div class="mt-lg">
					<button id="join-button" class="btn btn--primary" type="submit">
						<span class="btn-front">Toetreden tot coöperatie</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!------------------------------------------------------------------------------------------------>

<div id="found-modal" class="modal fade" 
	 tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title">Coöperatie oprichten</h2>
				
				<button class="btn-close" type="button" 
						data-bs-dismiss="modal" aria-label="Sluiten"></button>
			</div>
			
			<div class="modal-body">
				<div class="stack">
					<div>
						<label for="found-name-input" class="form-label">
							Naam:
						</label>
						<input id="found-name-input" class="form-control" type="text" required>
					</div>
					
					<div>
						<label for="access-select" class="form-label">
							Toetreding:
						</label>
						<select id="access-select" class="form-select" required>
							<option value="" selected disabled hidden>
								— kies een toetreding —
							</option>
							<option value="private">
								Alleen op uitnodiging
							</option>
							<option value="open">
								Open voor iedereen
							</option>
						</select>
					</div>
					
					<div>
						<label for="max-members-input" class="form-label">
							Maximum aantal leden:
						</label>
						<input id="max-members-input" class="form-control" type="number" 
							   min="2" max="100" step="1" required>
					</div>
				</div>
				
				<div id="found-name-error" class="mt-md error"></div>
				
				<div class="mt-lg">
					<button id="found-button" class="btn btn--primary" type="button">
						<span class="btn-front">Coöperatie oprichten</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!------------------------------------------------------------------------------------------------>

<div id="invite-modal" class="modal fade" 
	 tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title">Personage uitnodigen</h2>
				
				<button class="btn-close" type="button" 
						data-bs-dismiss="modal" aria-label="Sluiten"></button>
			</div>
			
			<div class="modal-body">
				<div class="stack">
					<div>
						<label for="first-name-input" class="form-label">
							Voornaam:
						</label>
						<input id="first-name-input" class="form-control" 
							   type="text" required>
					</div>
					
					<div>
						<label for="last-name-input" class="form-label">
							Achternaam:
						</label>
						<input id="last-name-input" class="form-control" 
							   type="text" required>
					</div>
				</div>
				
				<div id="invite-name-error" class="mt-md error"></div>
				
				<div class="mt-lg">
					<button id="invite-button" class="btn btn--primary" type="button">
						<span class="btn-front">Personage uitnodigen</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { turn } from '/js/turn-flow.js';
import { validateName } from '/js/name.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
let modals;
let state;
let manageCooperative;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	turn.phase.initialize();
});
//===============================================================================================//
turn.phase.load = function() {
	state = {
		cooperative: turn.storage.load('state.cooperative')
	}
	manageCooperative = turn.storage.load('actions.manageCooperative');
	
	cacheElements();
	createModals();
	addEventListeners();
	initializeControls();
}
//-----------------------------------------------------------------------------------------------//
turn.phase.save = function() {
	turn.storage.save({ key: 'actions.manageCooperative', value: manageCooperative });
}
//-----------------------------------------------------------------------------------------------//
turn.phase.updateUI = function() {
	renderLeaveAction();
	renderJoinAction();
	renderFoundAction();
	renderInviteActions();
}
//===============================================================================================//
function cacheElements() {
	elements = {
		leaveSection: document.getElementById('leave-section'),
		leaveAction: document.getElementById('leave-action-input'),
		openJoinWindow: document.getElementById('open-join-modal-button'),
		method: document.getElementById('method-select'),
		joinNameField: document.getElementById('join-name-div'),
		joinName: document.getElementById('join-name-input'),
		joinNameError: document.getElementById('join-name-error'),
		join: document.getElementById('join-form'),
		joinAction: document.getElementById('join-action-ul'),
		openFoundWindow: document.getElementById('open-found-modal-button'),
		access: document.getElementById('access-select'),
		maxMembers: document.getElementById('max-members-input'),
		foundName: document.getElementById('found-name-input'),
		foundNameError: document.getElementById('found-name-error'),
		found: document.getElementById('found-form'),
		foundAction: document.getElementById('found-action-ul'),
		inviteSection: document.getElementById('invite-section'),
		freeSlots: document.getElementById('free-slots-span'),
		openInviteWindow: document.getElementById('open-invite-modal-button'),
		firstName: document.getElementById('first-name-input'),
		lastName: document.getElementById('last-name-input'),
		inviteNameError: document.getElementById('invite-name-error'),
		invite: document.getElementById('invite-form'),
		inviteActions: document.getElementById('invite-actions-ul')
	};
}
//-----------------------------------------------------------------------------------------------//
function createModals() {
	modals = {
		join: bootstrap.Modal.getOrCreateInstance(
			document.getElementById('join-modal')
		),
		found: bootstrap.Modal.getOrCreateInstance(
			document.getElementById('found-modal')
		),
		invite: bootstrap.Modal.getOrCreateInstance(
			document.getElementById('invite-modal')
		)
	};
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.leaveAction.addEventListener('change', handleLeaveActionChange);
	
	elements.join.addEventListener('submit', handleJoin);
	elements.method.addEventListener('change', handleMethodChange);
	elements.joinName.addEventListener('input', handleJoinNameInput);
	
	elements.found.addEventListener('submit', handleFound);
	
	elements.invite.addEventListener('submit', handleInvite);
}
//-----------------------------------------------------------------------------------------------//
function initializeControls() {
	elements.leaveAction.checked = manageCooperative.leaveAction;
	elements.freeSlots.value = state.cooperative?.freeSlots ?? '';
}
//-----------------------------------------------------------------------------------------------//
async function findCooperative() {
	if (elements.method.value === 'random') {
		return {
			id: null,
			name: '(willekeurig)'
		}
	}
	
	try {
		const res = await fetch('/game/world/turn/manage-cooperative/find-cooperative', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ cooperativeName: elements.joinName.value })
		});
		
		const json = await res.json();
		
		if (json.error) {
			elements.joinNameError.textContent = json.error;
			return null;
		}
		
		return json.cooperative;
	} catch (err) {
		alert('De server is momenteel niet bereikbaar.');
		return null;
	}
}
//-----------------------------------------------------------------------------------------------//
async function reserveCooperativeName() {	
	try {
		const res = await fetch('/game/world/turn/manage-cooperative/reserve-cooperative-name', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ cooperativeName: elements.foundName.value })
		});
		
		const json = await res.json();
		
		if (json.error) {
			elements.cooperativeNameError.textContent = json.error;
			return null;
		}
		
		return json.cooperative;
	} catch (err) {
		alert('De server is momenteel niet bereikbaar.');
		return null;
	}
}
//-----------------------------------------------------------------------------------------------//
async function findCharacter() {
	try {
		const res = await fetch('/game/world/turn/manage-cooperative/find-character', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ 
				firstName: elements.firstName.value,
				lastName: elements.lastName.value
			})
		});
		
		const json = await res.json();
		
		if (json.error) {
			elements.inviteNameError.textContent = json.error;
			return null;
		}
		
		return json.character;
	} catch (err) {
		alert('De server is momenteel niet bereikbaar.');
		return null;
	}
}
//===============================================================================================//
function handleLeaveActionChange() {
	manageCooperative.leaveAction = elements.leaveAction.checked;
	
	turn.phase.updateUI();
}
//-----------------------------------------------------------------------------------------------//
async function handleJoin(event) {
	event.preventDefault();
	
	const cooperative = await findCooperative();
	
	if (!cooperative)
		return;
	
	manageCooperative.joinAction = { 
		cooperativeId: cooperative.id,
		cooperativeName: cooperative.name 
	};
	
	turn.phase.updateUI();
	
	modals.join.hide();	
}
//-----------------------------------------------------------------------------------------------//
function handleMethodChange() {
	const isChoose = elements.method.value === 'choose';
	
	elements.joinNameField.classList.toggle('d-none', !isChoose);
    elements.joinName.disabled = !isChoose;
}
//-----------------------------------------------------------------------------------------------//
function handleJoinNameInput() {
	elements.joinNameError.textContent = '';

	validateName({
		nameInput: elements.joinName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	});
}
//-----------------------------------------------------------------------------------------------//
async function handleFound(event) {
	event.preventDefault();
	
	const cooperative = await reserveCooperativeName();
	
	if (!cooperative)
		return;
	
	manageCooperative.foundAction = { 
		cooperativeId: cooperative.id,
		cooperativeName: cooperative.name,
		isOpen: elements.access.value === 'open',
		maxMembers: elements.maxMembers.value
	};
	
	turn.phase.updateUI();
	
	modals.found.hide();	
}
//-----------------------------------------------------------------------------------------------//
function handleFoundNameInput() {
	elements.foundNameError.textContent = '';

	validateName({
		nameInput: elements.foundName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	});
}
//-----------------------------------------------------------------------------------------------//
async function handleInvite(event) {
	event.preventDefault();
	
	const character = await findCharacter();
	
	if (!character)
		return;
	
	manageCooperative.inviteActions.push({ 
		inviteeId: character.id,
		inviteeFirstName: character.firstName,
		inviteeLastName: character.lastName,
		inviteeUsername: character.username
	});

	turn.phase.updateUI();
	
	modals.invite.hide();	
}
//-----------------------------------------------------------------------------------------------//
function renderLeaveAction() {
	elements.leaveAction.disabled = 
		manageCooperative.joinAction ||
		manageCooperative.foundAction ||
		turn.phase.disabled;
	
	elements.leaveSection.classList.toggle(
        'd-none',
        !state.cooperative
    );
}
//-----------------------------------------------------------------------------------------------//
function renderJoinAction() {
	elements.joinAction.innerHTML = '';
	
	if (manageCooperative.joinAction) {
		const li = document.createElement('li');
		li.className = 'list-item-justify';
		
		if (manageCooperative.joinAction.cooperativeId !== null)
			li.dataset.cooperativeId = manageCooperative.joinAction.cooperativeId;
		
		const span = document.createElement('span');
		span.textContent = manageCooperative.joinAction.cooperativeName;
		
		const button = document.createElement('button');
		button.type = 'button';
		button.classList.add('btn-close');
		button.disabled = turn.phase.disabled;
		
		button.addEventListener('click', () => {
			if (button.disabled)
				return;
			
			manageCooperative.joinAction = null;
			turn.phase.updateUI();
		});
		
		li.appendChild(span);
		li.appendChild(button);
		elements.joinAction.appendChild(li);
	}
	
	elements.joinAction.classList.toggle(
        'd-none',
        !manageCooperative.joinAction
    );
	
	elements.openJoinWindow.disabled = 
		(state.cooperative && !manageCooperative.leaveAction) ||
		manageCooperative.foundAction ||
		turn.phase.disabled;
	
	elements.method.value = '';
	elements.joinName.textContent = '';
	handleMethodChange();
}
//-----------------------------------------------------------------------------------------------//
function renderFoundAction() {
	elements.foundAction.innerHTML = '';
	
	if (manageCooperative.foundAction) {
		const li = document.createElement('li');
		li.className = 'list-item-justify';
		
		li.dataset.cooperativeId = manageCooperative.foundAction.cooperativeId;
		
		const access = manageCooperative.foundAction.isOpen ? 'open' : 'privé';
		const maxMembers = manageCooperative.foundAction.maxMembers;
		const small = document.createElement('small');
		small.textContent = `(${access}, max. ${maxMembers})`;
		
		const span = document.createElement('span');
		span.textContent = `${manageCooperative.foundAction.cooperativeName} `;
		
		const button = document.createElement('button');
		button.type = 'button';
		button.classList.add('btn-close');
		button.disabled = turn.phase.disabled;
		
		button.addEventListener('click', () => {
			if (button.disabled)
				return;
			
			manageCooperative.foundAction = null;
			turn.phase.updateUI();
		});
		
		span.appendChild(small);
		li.appendChild(span);
		li.appendChild(button);
		elements.foundAction.appendChild(li);
	}
	
	elements.foundAction.classList.toggle(
        'd-none',
        elements.foundAction.children.length === 0
    );
	
	elements.openFoundWindow.disabled = 
		(state.cooperative && !manageCooperative.leaveAction) ||
		manageCooperative.joinAction ||
		turn.phase.disabled;
	
	elements.access.value = '';
	elements.maxMembers.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
function renderInviteActions() {
	elements.inviteActions.innerHTML = '';
	
	if (manageCooperative.inviteActions) {
		manageCooperative.inviteActions.forEach((ia, index) => {
			const li = document.createElement('li');
			li.className = 'list-item-justify';
			
			li.dataset.inviteeId = ia.inviteeId;
			
			const small = document.createElement('small');
			small.textContent = `(${ia.inviteeUsername})`;
			
			const span = document.createElement('span');
			span.textContent = `${ia.inviteeFirstName} ${ia.inviteeLastName}`;
			
			const button = document.createElement('button');
			button.type = 'button';
			button.classList.add('btn-close');
			button.disabled = turn.phase.disabled;
			
			button.addEventListener('click', () => {
				if (button.disabled)
					return;
				
				manageCooperative.inviteActions.splice(index, 1);
				turn.phase.updateUI();
			});
			
			span.appendChild(small);
			li.appendChild(span);
			li.appendChild(button);
			elements.inviteActions.appendChild(li);
		});
	}
	
	elements.inviteActions.classList.toggle(
        'd-none',
        elements.inviteActions.children.length === 0
    );
	
	elements.openInviteWindow.disabled = 
		manageCooperative.leaveAction ||
		turn.phase.disabled;
	
	elements.inviteSection.classList.toggle(
        'd-none',
        !state.cooperative
    );
}
//-----------------------------------------------------------------------------------------------//
</script>