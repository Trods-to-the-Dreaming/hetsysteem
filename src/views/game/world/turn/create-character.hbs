{{#block "title"}}Personage aanmaken{{/block}}

<!------------------------------------------------------------------------------------------------>

{{#block "headScripts"}}
<script type="module">
import { turn } from '/js/turn-check-access.js';
await turn.phase.checkAccess('createCharacter');
</script>
{{/block}}

<!------------------------------------------------------------------------------------------------>

<form id="phase-form" class="d-none">
	<h1>Personage aanmaken</h1>

	<div class="mt-md stack">
		<div>
			<label for="first-name-input" class="form-label">
				Voornaam:
			</label>
			<input id="first-name-input" class="form-control" type="text" required>
		</div>
		
		<div>
			<label for="last-name-input" class="form-label">
				Achternaam:
			</label>
			<input id="last-name-input" class="form-control" type="text" required>
		</div>
		
		<div>
			<label for="job-preference-1-select" class="form-label">
				Jobvoorkeur (★★★):
			</label>
			<select id="job-preference-1-select" class="form-select" required></select>
		</div>
		
		<div>
			<label for="job-preference-2-select" class="form-label">
				Jobvoorkeur (★★):
			</label>
			<select id="job-preference-2-select" class="form-select" required></select>
		</div>
		
		<div>
			<label for="job-preference-3-select" class="form-label">
				Jobvoorkeur (★):
			</label>
			<select id="job-preference-3-select" class="form-select" required></select>
		</div>
		
		<div>
			<label for="recreation-preference-select" class="form-label">
				Ontspanningsvoorkeur (★★★):
			</label>
			<select id="recreation-preference-select" class="form-select" required></select>
		</div>
	</div>
	
	<div id="character-name-error" class="mt-md error"></div>
</form>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { turn } from '/js/turn-flow.js';
import { validateName } from '/js/name.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
let constants;
let character;
let actions;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	turn.phase.initialize();
});
//===============================================================================================//
turn.phase.load = function() {
	constants = turn.storage.loadNamespace('constants');
	character = turn.storage.loadNamespace('character');
	actions = turn.storage.load('phaseActions.createCharacterActions');
	
	cacheElements();
	addEventListeners();
	initializeControls();
}
//-----------------------------------------------------------------------------------------------//
turn.phase.save = function() {
	actions = {
		jobPreferences: elements.jobPreferences.map(
			jobPreference => ({ buildingId: jobPreference.value })
		),
		recreationPreference: { productId: elements.recreationPreference.value }
	};

	turn.storage.save({ key: 'phaseActions.createCharacterActions', value: actions });
}
//-----------------------------------------------------------------------------------------------//
turn.phase.updateUI = function() {
	handleJobPreferenceChange();
	
	elements.firstName.disabled = this.disabled;
	elements.lastName.disabled = this.disabled;
	elements.jobPreferences.forEach((jobPreference, index) => {
		jobPreference.disabled = this.disabled;
	});
	elements.recreationPreference.disabled = this.disabled;
}
//-----------------------------------------------------------------------------------------------//
turn.phase.confirm = async function () {
	const character = await reserveCharacterName();
	
	if(!character)
		return false;
	
	elements.firstName.value = character.firstName;
	elements.lastName.value = character.lastName;
	
    return true;
};
//===============================================================================================//
function cacheElements() {
	elements = {
		firstName: document.getElementById('first-name-input'),
		lastName: document.getElementById('last-name-input'),
		jobPreferences: [
			document.getElementById('job-preference-1-select'),
			document.getElementById('job-preference-2-select'),
			document.getElementById('job-preference-3-select')
		],
		recreationPreference: document.getElementById('recreation-preference-select'),
		characterNameError: document.getElementById('character-name-error')
	};
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.firstName.addEventListener('input', handleFirstNameInput);
	elements.lastName.addEventListener('input', handleLastNameInput);
	elements.jobPreferences.forEach((jobPreference) => {
		jobPreference.addEventListener('change', handleJobPreferenceChange);
	});
}
//-----------------------------------------------------------------------------------------------//
function initializeControls() {
	elements.jobPreferences.forEach((jobPreference) => {
		turn.phase.populateSelect({
			select: jobPreference,
			optionName: 'job',
			items: constants.jobs,
			textField: 'type'
		});
	});
	
	turn.phase.populateSelect({
		select: elements.recreationPreference,
		optionName: 'ontspanning',
		items: constants.recreations,
		textField: 'type'
	});
	
	elements.firstName.value = character.firstName ?? '';
	elements.lastName.value = character.lastName ?? '';	
	elements.jobPreferences.forEach((jobPreference, index) => {
		jobPreference.value = actions.jobPreferences[index].buildingId ?? '';
	});
	elements.recreationPreference.value = actions.recreationPreference.productId ?? '';
}
//===============================================================================================//
function handleFirstNameInput() {
	elements.characterNameError.textContent = '';
	
	validateName({
		nameInput: elements.firstName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	});
}
//-----------------------------------------------------------------------------------------------//
function handleLastNameInput() {
	elements.characterNameError.textContent = '';

	validateName({
		nameInput: elements.lastName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	});
}
//-----------------------------------------------------------------------------------------------//
function handleJobPreferenceChange() {
	const selectedValues = elements.jobPreferences.map(select => select.value);
	
	elements.jobPreferences.forEach((select, index) => {
		const otherSelectedValues = selectedValues.filter((_, i) => i !== index);
		
		Array.from(select.options).forEach(option => {
			option.disabled = otherSelectedValues.includes(option.value);
		});
	});
}
//===============================================================================================//
async function reserveCharacterName() {
	try {
		const json = await turn.fetchJson({
			url: '/game/world/turn/create-character/reserve-character-name', 
			body: { 
				firstName: elements.firstName.value, 
				lastName: elements.lastName.value
			}
		});
		
		if (json === null)
			return null;

		if (json.error) {
			elements.characterNameError.textContent = json.error;
			return null;
		}
		
		return json.character;
	} catch (err) {
		turn.showNetworkError();
		return null;
	}
}
//-----------------------------------------------------------------------------------------------//
</script>