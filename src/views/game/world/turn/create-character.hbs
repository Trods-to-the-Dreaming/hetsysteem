{{#block "title"}}Personage aanmaken{{/block}}

<!------------------------------------------------------------------------------------------------>

{{#block "headScripts"}}
<script type="module">
import { turn } from '/js/turn-check-access.js';
await turn.phase.checkAccess('createCharacter');
</script>
{{/block}}

<!------------------------------------------------------------------------------------------------>

<div id="container-div" class="d-none">
	<h1>Personage aanmaken</h1>

	<div class="mt-md stack">
		<div>
			<label for="first-name-input" class="form-label">
				Voornaam:
			</label>
			<input id="first-name-input" class="form-control" type="text" required>
		</div>
		
		<div>
			<label for="last-name-input" class="form-label">
				Achternaam:
			</label>
			<input id="last-name-input" class="form-control" type="text" required>
		</div>
		
		<div>
			<label for="job-preference-1-select" class="form-label">
				Jobvoorkeur (★★★):
			</label>
			<select id="job-preference-1-select" class="form-select" required>
				<option value="" 
						{{#unless jobPreferences.[0].buildingId}}selected{{/unless}}
						hidden disabled>
					— kies een job —
				</option>
				{{#each jobs}}
					<option value="{{id}}" 
							{{#if (eq id ../jobPreferences.[0].buildingId)}}selected{{/if}}>
						{{type}}
					</option>
				{{/each}}
			</select>
		</div>
		
		<div>
			<label for="job-preference-2-select" class="form-label">
				Jobvoorkeur (★★):
			</label>
			<select id="job-preference-2-select" class="form-select" required>
				<option value="" 
						{{#unless jobPreferences.[1].buildingId}}selected{{/unless}} 
						hidden disabled>
					— kies een job —
				</option>
				{{#each jobs}}
					<option value="{{id}}" 
							{{#if (eq id ../jobPreferences.[1].buildingId)}}selected{{/if}}>
						{{type}}
					</option>
				{{/each}}
			</select>
		</div>
		
		<div>
			<label for="job-preference-3-select" class="form-label">
				Jobvoorkeur (★):
			</label>
			<select id="job-preference-3-select" class="form-select" required>
				<option value="" 
						{{#unless jobPreferences.[2].buildingId}}selected{{/unless}} 
						hidden disabled>
					— kies een job —
				</option>
				{{#each jobs}}
					<option value="{{id}}" 
							{{#if (eq id ../jobPreferences.[2].buildingId)}}selected{{/if}}>
						{{type}}
					</option>
				{{/each}}
			</select>
		</div>
		
		<div>
			<label for="recreation-preference-select" class="form-label">
				Ontspanningsvoorkeur (★★★):
			</label>
			<select id="recreation-preference-select" class="form-select" required>
				<option value="" 
						{{#unless recreationPreference.productId}}selected{{/unless}} 
						hidden disabled>
					— kies een activiteit —
				</option>
				{{#each recreations}}
					<option value="{{id}}" 
							{{#if (eq id ../recreationPreference.productId)}}selected{{/if}}>
						{{type}}
					</option>
				{{/each}}
			</select>
		</div>
	</div>
	
	<div id="character-name-error" class="mt-md error"></div>
</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { turn } from '/js/turn-flow.js';
import { validateName } from '/js/name.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
let data;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	turn.phase.initialize();
});
//===============================================================================================//
turn.phase.load = function() {
	loadData();
	cacheElements();
	initializeControls();
	addEventListeners();
}
//-----------------------------------------------------------------------------------------------//
turn.phase.save = function() {
	const createCharacter = {
		firstName: elements.firstName.value,
		lastName: elements.lastName.value,
		jobPreferences: elements.jobPreferences.map(
			jobPreference => jobPreference.value
		),
		recreationPreference: elements.recreationPreference.value
	};
	
	turn.storage.save('characterPhases.createCharacter', createCharacter);
}
//-----------------------------------------------------------------------------------------------//
turn.phase.updateUI = function() {
	elements.firstName.value = data.firstName;
	elements.lastName.value = data.lastName;
	elements.jobPreferences.forEach((jobPreference, index) => {
		jobPreference.value = data.jobPreferences[index];
	});
	elements.recreationPreference.value = data.recreationPreference;
	
	handleJobPreferenceChange();
}
//-----------------------------------------------------------------------------------------------//
turn.phase.confirm = async function () {
	if (!validateCharacter())
        return false;
	
    const reserved = await reserveCharacterName();
	
	if(!reserved)
		return false;
	
	elements.firstName.value = reserved.firstName;
	elements.lastName.value = reserved.lastName;
	
    return true;
};
//===============================================================================================//
function loadData() {
	const createCharacter = turn.storage.load('characterPhases.createCharacter') ?? {};
	const jobs = turn.storage.load('constants.jobs');
	const recreations = turn.storage.load('constants.recreations');
	
	data = {
		firstName: createCharacter.firstName ?? '',
		lastName: createCharacter.lastName ?? '',
		jobPreferences: createCharacter.jobPreferences ?? ['', '', ''],
		recreationPreference: createCharacter.recreationPreference ?? '',
		jobs,
		recreations
	};
}
//-----------------------------------------------------------------------------------------------//
function cacheElements() {
	elements = {
		firstName: document.getElementById('first-name-input'),
		lastName: document.getElementById('last-name-input'),
		jobPreferences: [
			document.getElementById('job-preference-1-select'),
			document.getElementById('job-preference-2-select'),
			document.getElementById('job-preference-3-select')
		],
		recreationPreference: document.getElementById('recreation-preference-select'),
		characterNameError: document.getElementById('character-name-error')
	};
}
//-----------------------------------------------------------------------------------------------//
function initializeControls() {
	elements.jobPreferences.forEach((jobPreference) => {
		turn.phase.populateSelect({
			select: jobPreference,
			optionName: 'job',
			items: data.jobs,
			textField: 'type'
		});
	});
	
	turn.phase.populateSelect({
		select: elements.recreationPreference,
		optionName: 'ontspanning',
		items: data.recreations,
		textField: 'type'
	});
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.firstName.addEventListener('input', handleFirstNameInput);
	elements.lastName.addEventListener('input', handleLastNameInput);
	elements.jobPreferences.forEach((jobPreference) => {
		jobPreference.addEventListener('change', handleJobPreferenceChange);
	});
}
//-----------------------------------------------------------------------------------------------//
function validateCharacter() {
	const fields = [
		elements.firstName,
		elements.lastName,
		...elements.jobPreferences,
		elements.recreationPreference
	];

	for (const field of fields) {
		if (!field.reportValidity())
			return false;
	}

	return true;
}
//-----------------------------------------------------------------------------------------------//
async function reserveCharacterName() {
	try {
		const res = await fetch('/game/world/turn/create-character/reserve-character-name', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ 
				firstName: elements.firstName.value, 
				lastName: elements.lastName.value
			})
		});
		
		const json = await res.json();
		
		if (json.error) {
			elements.characterNameError.textContent = json.error;
			return null;
		}
		
		const reserved = {
			firstName: json.data.firstName,
			lastName: json.data.lastName
		};
		
		return reserved;
	} catch (err) {
		alert('De server is momenteel niet bereikbaar.');
		return null;
	}
}
//===============================================================================================//
function handleFirstNameInput() {
	elements.characterNameError.textContent = '';
	
	const args = {
		nameInput: elements.firstName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	};
	
	validateName(args);
}
//-----------------------------------------------------------------------------------------------//
function handleLastNameInput() {
	elements.characterNameError.textContent = '';
	
	const args = {
		nameInput: elements.lastName,
		minLength: 3,
		maxLength: 20,
		regex: /^\p{L}+(?:[ '-]\p{L}+)*$/u
	};
	
	validateName(args);
}
//-----------------------------------------------------------------------------------------------//
function handleJobPreferenceChange() {
	const selectedValues = elements.jobPreferences.map(select => select.value);
	
	elements.jobPreferences.forEach((select, index) => {
		const otherSelectedValues = selectedValues.filter((_, i) => i !== index);
		
		Array.from(select.options).forEach(option => {
			option.disabled = otherSelectedValues.includes(option.value);
		});
	});
}
//-----------------------------------------------------------------------------------------------//
</script>