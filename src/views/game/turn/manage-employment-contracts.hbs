<div id="start-window" class="modal fade" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3 class="modal-title">Zaak starten</h3>
				
				<button class="btn-close" type="button" data-bs-dismiss="modal"></button>
			</div>
			
			<div class="modal-body">
				<form id="start-form">
					<div class="stack">
						<div>
							<label for="start-building-select" class="form-label">
								Gebouw:
							</label>
							<select id="start-building-select" class="form-select" required></select>
						</div>
						
						<div>
							<label for="start-hours-input" class="form-label">
								Aantal werkuren:
							</label>
							<input id="start-hours-input" class="form-control" type="number" 
								   min="0" max="0" step="1" value="0" required>
						</div>
					</div>
					
					<div class="mt-lg">
						<button id="confirm-start-button" class="btn btn--primary" type="submit">
							<span class="btn-front">Zaak starten</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

