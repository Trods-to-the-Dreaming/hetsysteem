<div id="close-window" class="modal fade" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3 class="modal-title">Zaken sluiten</h3>
				
				<button class="btn-close" type="button" data-bs-dismiss="modal"></button>
			</div>
	
			<div class="modal-body">
				<div class="stack">
					<label class="form-label">
						Vink de zaken aan:
					</label>
					<div id="closeable-businesses-div"></div>
				</div>
				
				<div class="mt-lg">
					<button id="confirm-close-button" class="btn btn--primary" type="button">
						<span class="btn-front">Zaken sluiten</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

