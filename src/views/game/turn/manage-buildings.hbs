{{#block "title"}}Gebouwen beheren{{/block}}

<!------------------------------------------------------------------------------------------------>

{{#block "headScripts"}}
<script type="module">
import { turn } from '/js/turn-check-access.js';
turn.phase.checkAccess('manageBuildings');
</script>
{{/block}}

<!------------------------------------------------------------------------------------------------>

<div id="container-div" class="container-compact d-none">
	<h1>Gebouwen beheren</h1>
	
	<div id="form-div" class="form-block">
		<div id="demolish-div">
			<h2 class="mt-0">💥 Slopen</h2>
			
			<ul id="demolished-buildings-ul" class="list-compact d-none"></ul>
			
			<button id="open-demolish-window-button" class="button-2" type="button" 
					data-bs-toggle="offcanvas" data-bs-target="#demolish-window">
				Bestaande gebouwen slopen...
			</button>
		</div>
		
		<div id="build-div">
			<h2 class="mt-0">🏗️ Bouwen</h2>
			
			<p>Vrije landtegels: <span id="free-tiles-span"></span></p>

			<ul id="new-construction-sites-ul" class="list-compact d-none"></ul>
			
			<button id="open-construct-window-button" class="button-2" type="button" 
					data-bs-toggle="offcanvas" data-bs-target="#construct-window">
				Nieuw gebouw plaatsen...
			</button>
		</div>
	</div>
</div>

<div id="demolish-window" class="offcanvas offcanvas-start" 
	 data-bs-backdrop="true" data-bs-scroll="false" tabindex="-1">
	<div class="offcanvas-header">
		<h2>💥 Slopen</h2>
		
		<button class="btn-close" type="button" data-bs-dismiss="offcanvas"></button>
	</div>
	
	<div class="offcanvas-body form-block">
		<div>
			<p>Vink de gebouwen aan:</p>
			
			<div id="preserved-buildings-div" class="field"></div>
		</div>
		
		<button id="confirm-demolish-button" class="button-2" type="button">
			Gebouwen slopen
		</button>
	</div>
</div>

<div id="construct-window" class="offcanvas offcanvas-start" 
	 data-bs-backdrop="true" data-bs-scroll="false" tabindex="-1">
	<div class="offcanvas-header">
		<h2>🏗️ Bouwen</h2>
		
		<button class="btn-close" type="button" data-bs-dismiss="offcanvas"></button>
	</div>
	
	<div class="offcanvas-body">
		<form id="construct-form" class="form-block">
			<div class="form-fields">
				<div>
					<label for="building-type-select" class="form-label">
						Gebouw:
					</label>
					<select id="building-type-select" class="form-select" required></select>
				</div>
				
				<div>
					<label for="building-size-select" class="form-label">
						Grootte:
					</label>
					<select id="building-size-select" class="form-select" required></select>
				</div>
				
				<div>
					<label for="building-name-input" class="form-label">
						Naam:
					</label>
					<input id="building-name-input" class="form-control" type="text" required>
				</div>
			</div>
			
			<p id="building-name-error" class="error"></p>
			
			<button id="confirm-construct-button" class="button-2" type="submit">
				Gebouw plaatsen
			</button>
		</form>
	</div>
</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { turn } from '/js/turn-flow.js';
import { validateName } from '/js/name.validation.js';
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	turn.phase.initialize();
});
//===============================================================================================//
turn.phase.load = function() {
	loadPhaseData();
	cachePhaseElements();
	createOffcanvasObjects();
	
	const { data, elements } = turn.phase;
	
	elements.confirmDemolish.addEventListener('click', handleConfirmDemolish);
	elements.confirmConstruct.addEventListener('click', handleConfirmConstruct);
	elements.buildingName.addEventListener('input', handleBuildingNameInput);
	
	turn.phase.populateSelect({
		select: elements.buildingType, 
		optionName: 'gebouw', 
		items: data.constructibleBuildings, 
		textField: 'type'
	});
	turn.phase.populateSelect({
		select: elements.buildingSize, 
		optionName: 'grootte', 
		items: data.buildingSizes
	});
}
//-----------------------------------------------------------------------------------------------//
turn.phase.save = function() {
	const { data } = turn.phase;
	const manageBuildings = {
		demolish: [],
		construct: []
	};
	
	data.demolishableBuildings.forEach((db) => {
		if (db.isDemolished) {
			manageBuildings.demolishActions.push({
				characterBuildingId: db.characterBuildingId
			});
		}
	});
	
	data.newConstructionSites.forEach((ncs) => {
		manageBuildings.constructActions.push({
			characterBuildingId: ncs.characterBuildingId,
			buildingId: ncs.buildingId,
			size: ncs.size
		});
	});
	
	turn.storage.save('characterPhases.manageBuildings', manageBuildings);
}
//-----------------------------------------------------------------------------------------------//
turn.phase.updateUI = function() {
	renderDemolishList();
	renderConstructList();
	renderFreeTiles();
}
//===============================================================================================//
function loadPhaseData() {
	const manageBuildings = turn.storage.load('characterPhases.manageBuildings');
	const buildings = turn.storage.load('constants.buildings');
	const buildingSizes = turn.storage.load('constants.buildingSizes');
	const ownedTiles = turn.storage.load('characterState.ownedTiles');
	const ownedBuildings = turn.storage.load('characterState.ownedBuildings');
	const ownedReservedBuildings = turn.storage.load('characterState.ownedReservedBuildings');
	const ownedConstructionSites = turn.storage.load('characterState.ownedConstructionSites');
	
	const constructibleBuildings = buildings.filter((b) => b.isConstructible);
	
	const buildingsById = Object.fromEntries(
		buildings.map((b) => [b.id, b])
	);
	const ownedReservedBuildingsById = Object.fromEntries(
		ownedReservedBuildings.map((orb) => [orb.id, orb])
	);
	const ownedConstructionSitesById = Object.fromEntries(
		ownedConstructionSites.map((ocs) => [ocs.id, ocs])
	);
	const demolishedIds = new Set(
		manageBuildings.demolishActions.map((a) => a.id)
	);
	
	const demolishableBuildings = ownedBuildings.map(
		({ id, name, buildingId, size }) => {
			const base = buildingsById[buildingId];

			if (base.slug === 'construction-site') {
				const site = ownedConstructionSitesById[id];
				const building = buildingsById[site.buildingId];

				return {
					characterBuildingId: id,
					name,
					buildingId: site.buildingId,
					type: building.type,
					size,
					bricksUsed: site.bricksUsed,
					bricksNeeded: site.bricksNeeded,
					isDemolished: demolishedIds.has(id)
				};
			}

			return {
				characterBuildingId: id,
				name,
				buildingId,
				type: base.type,
				size,
				bricksUsed: null,
				bricksNeeded: null,
				isDemolished: demolishedIds.has(id)
			};
		});
	
	const newConstructionSites = manageBuildings.constructActions.map(
		({ characterBuildingId, buildingId, size }) => {
			const reservedBuilding = ownedReservedBuildingsById[characterBuildingId];
			const building = buildingsById[buildingId];
			
			return {
				characterBuildingId,
				name: reservedBuilding.name,
				buildingId,
				type: building.type,
				size
			};
		});
	
	const usedTiles = 
		demolishableBuildings
			.filter((b) => !b.isDemolished)
			.reduce((sum, b) => sum + b.size, 0)
		+
		newConstructionSites
			.reduce((sum, b) => sum + b.size, 0);
	const freeTiles = ownedTiles - usedTiles;
	
	turn.phase.data = {
		buildings,
		constructibleBuildings,
		buildingSizes,
		ownedReservedBuildings,
		demolishableBuildings,
		newConstructionSites,
		freeTiles
	};
}
//-----------------------------------------------------------------------------------------------//
function cachePhaseElements() {
	turn.phase.elements = {
		demolishWindow: document.getElementById('demolish-window'),
		constructWindow: document.getElementById('construct-window'),
		openDemolishWindow: document.getElementById('open-demolish-window-button'),
		openConstructWindow: document.getElementById('open-construct-window-button'),
		confirmDemolish: document.getElementById('confirm-demolish-button'),
		confirmConstruct: document.getElementById('confirm-construct-button'),
		constructForm: document.getElementById('construct-form'),
		demolishedBuildings: document.getElementById('demolished-buildings-ul'),
		newConstructionSites: document.getElementById('new-construction-sites-ul'),
		preservedBuildings: document.getElementById('preserved-buildings-div'),
		freeTiles: document.getElementById('free-tiles-span'),
		buildingType: document.getElementById('building-type-select'),
		buildingSize: document.getElementById('building-size-select'),
		buildingName: document.getElementById('building-name-input'),
		buildingNameError: document.getElementById('building-name-error')
	};
}
//-----------------------------------------------------------------------------------------------//
function createOffcanvasObjects() {
	const { elements } = turn.phase;
	
	turn.phase.demolishOffcanvas = new bootstrap.Offcanvas(elements.demolishWindow);
	turn.phase.constructOffcanvas = new bootstrap.Offcanvas(elements.constructWindow);
}
//===============================================================================================//
function handleConfirmDemolish() {
	const { data, elements } = turn.phase;

	const checkboxes = elements.preservedBuildings
		.querySelectorAll('input[type="checkbox"]:checked');

	checkboxes.forEach((checkbox) => {
		const characterBuildingId = Number(checkbox.dataset.characterBuildingId);
		const building = data.demolishableBuildings.find(
			(db) => db.characterBuildingId === characterBuildingId
		);
		
		building.isDemolished = true;
		data.freeTiles += building.size;
	});
	
	turn.phase.updateUI();
	
	turn.phase.demolishOffcanvas.hide();
}
//-----------------------------------------------------------------------------------------------//
async function handleConfirmConstruct(event) {
	event.preventDefault();
	
	const { data, elements } = turn.phase;
	
	if (!elements.constructForm.reportValidity()) return;
	
	const reserved  = await reserveBuildingName();
	if (!reserved) return;
	
	const buildingId = Number(elements.buildingType.value);
	const size = Number(elements.buildingSize.value);
	
	const building = data.buildings.find((b) => b.id === buildingId);
	
	data.newConstructionSites.push({
		characterBuildingId: reserved.id,
		name: reserved.name,
		buildingId,
		type: building.type,
		size
	});

	data.ownedReservedBuildings.push(reserved);
	
	data.freeTiles -= size;
	
	turn.storage.save('characterState.ownedReservedBuildings', data.ownedReservedBuildings);

	turn.phase.updateUI();
	turn.phase.constructOffcanvas.hide();
}
//-----------------------------------------------------------------------------------------------//
function handleBuildingNameInput() {
	const { elements } = turn.phase;
	
	elements.buildingNameError.textContent = '';
	
	const nameInput = elements.buildingName;
	const args = {
		nameInput,
		minLength: 2,
		maxLength: 32,
		regex: /^[\p{L}\p{N}]+(?:[ '\-.:?!&][\p{L}\p{N}]+)*$/u
	};
	
	validateName(args);
	//nameInput.reportValidity();
	
	//updateConstructUI();
}
//===============================================================================================//
function renderDemolishList() {
	const { data, elements } = turn.phase;
	
	elements.demolishedBuildings.innerHTML = '';
	elements.preservedBuildings.innerHTML = '';
	
	data.demolishableBuildings.forEach((db) => {
		if (db.isDemolished) {
			// Add to demolished buildings list
			const li = document.createElement('li');
			li.className = 'list-item-justify';
			li.dataset.characterBuildingId = db.characterBuildingId;
			
			const span = document.createElement('span');
			span.innerHTML = createBuildingLabel(db);
			li.appendChild(span);
			
			if (db.size <= data.freeTiles) {
				const button = document.createElement('button');
				button.type = 'button';
				button.classList.add('btn-close');
				button.disabled = turn.phase.disabled;
				button.addEventListener('click', () => {
					db.isDemolished = false;
					data.freeTiles -= db.size;
					turn.phase.updateUI();
				});
				li.appendChild(button);
			}

			elements.demolishedBuildings.appendChild(li);
		} else {
			// Add to preserved buildings list
			const div = document.createElement('div');
			div.className = 'form-check';
			
			const input = document.createElement('input');
			input.id = 'demolish_' + db.characterBuildingId;
			input.className = 'form-check-input';
			input.type = 'checkbox';
			input.dataset.characterBuildingId = db.characterBuildingId;
			div.appendChild(input);
			
			const label = document.createElement('label');
			label.htmlFor = input.id;
			label.className = 'form-check-label';
			label.innerHTML = createBuildingLabel(db);
			div.appendChild(label);
			
			elements.preservedBuildings.appendChild(div);
		}
	});
	
	// Show/hide demolished buildings list
	if (elements.demolishedBuildings.children.length === 0) {
		elements.demolishedBuildings.classList.add('d-none');
	} else {
		elements.demolishedBuildings.classList.remove('d-none');
	}
	
	// Enable/disable demolish window
	let areAllBuildingsDemolished = true;
	for (const ob of data.demolishableBuildings) {
		if (!ob.isDemolished) {
			areAllBuildingsDemolished = false;
			break;
		}
	}
	elements.openDemolishWindow.disabled = areAllBuildingsDemolished || turn.phase.disabled;
}
//-----------------------------------------------------------------------------------------------//
function renderConstructList() {
	const { data, elements } = turn.phase;
	
	elements.newConstructionSites.innerHTML = '';
	
	data.newConstructionSites.forEach((ncs, index) => {
		// Add to new construction sites list
		const li = document.createElement('li');
		li.className = 'list-item-justify';
		li.dataset.characterBuildingId = ncs.characterBuildingId;
		
		const span = document.createElement('span');
		span.innerHTML = createBuildingLabel(ncs);
		li.appendChild(span);
		
		const button = document.createElement('button');
		button.type = 'button';
		button.classList.add('btn-close');
		button.disabled = turn.phase.disabled;
		button.addEventListener('click', () => {
			data.newConstructionSites.splice(index, 1);
			data.freeTiles += ncs.size;
			turn.phase.updateUI();
		});
		li.appendChild(button);
		
		elements.newConstructionSites.appendChild(li);
	});
	
	elements.buildingType.value = '';
	elements.buildingName.value = '';
	elements.buildingSize.value = '';
	for (const option of elements.buildingSize.options) {
		const tiles = Number(option.value);
		option.disabled = tiles > data.freeTiles;
	}
	
	//updateConstructUI();
	
	// Show/hide new construction sites list
	if (elements.newConstructionSites.children.length === 0) {
		elements.newConstructionSites.classList.add('d-none');
	} else {
		elements.newConstructionSites.classList.remove('d-none');
	}
	
	// Enable/disable construct window
	const areAllTilesOccupied = (data.freeTiles === 0);
	elements.openConstructWindow.disabled = areAllTilesOccupied || turn.phase.disabled;
}
//-----------------------------------------------------------------------------------------------//
function renderFreeTiles() {
	const { data, elements } = turn.phase;
	
	elements.freeTiles.textContent = data.freeTiles;
}
//===============================================================================================//
async function reserveBuildingName() {
	const { elements } = turn.phase;
	const requestedName = elements.buildingName.value;
	
	try {
		const res = await fetch('/game/turn/reserve-building-name', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ characterBuildingName: requestedName })
		});

		const json = await res.json();
		
		if (!json.success) {
			elements.buildingNameError.textContent = json.error.message;
			return null;
		}
		
		return {
			id: json.data.characterBuildingId,
			name: json.data.characterBuildingName
		};
	} catch (err) {
		console.error(err);
		return null;
	}
}
//-----------------------------------------------------------------------------------------------//
