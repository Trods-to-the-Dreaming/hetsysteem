	const { elements } = turn.phase;
	
	if (elements.buildingType.value === '' ||
		elements.buildingName.value === '' ||
		!elements.buildingName.checkValidity()) {
		elements.confirmConstruct.disabled = true;
	} else {
		elements.confirmConstruct.disabled = false;
	}
}*/
//-----------------------------------------------------------------------------------------------//
function createBuildingLabel({ name, 
							   type, 
							   size, 
							   bricksUsed, 
							   bricksNeeded }) {
  const unit = size === 1 ? 'tegel' : 'tegels';

  const parts = [
    type,
    `${size} ${unit}`
  ];

  if (bricksUsed != null && bricksNeeded != null) {
    parts.push(`${bricksUsed}/${bricksNeeded} voltooid`);
  }

  return `${name} <small>(${parts.join(', ')})</small>`;
}
//-----------------------------------------------------------------------------------------------//
</script>