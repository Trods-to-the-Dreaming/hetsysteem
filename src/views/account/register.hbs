{{#block "title"}}Inschrijven{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Inschrijven</h1>

<form id="register-form" 
	  method="POST" action="/account/register">
	<div class="mt-md stack">
		<div>
			<label for="username-input" class="form-label">
				Gebruikersnaam:
			</label>
			<input id="username-input" class="form-control" type="text" 
				   name="username" value="{{username}}" required>
		</div>
		
		<div>
			<label for="password-input" class="form-label">
				Wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password" 
				   name="password" required>
		</div>
		
		<div>
			<label for="confirmed-password-input" class="form-label">
				Bevestig wachtwoord:
			</label>
			<input id="confirmed-password-input" class="form-control" type="password" 
				   name="confirmedPassword" required>
		</div>
		
		<div>
			<label for="invitation-token-input" class="form-label">
				Uitnodigingscode:
			</label>
			<input id="invitation-token-input" class="form-control" type="text" 
				   name="invitationToken" required>
		</div>
	</div>
	
	<div id="register-error" class="mt-md error">{{registerError}}</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Inschrijven</span>
		</button>
	</div>
</form>

<hr>

<div>Reeds lid? <a href="/account/login">Aanmelden</a>.</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { validateUsername } from '/js/username.validation.js';
import { validatePassword } from '/js/password.validation.js';
import { validateInvitationToken } from '/js/invitation-token.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	cacheElements();
	addEventListeners();
});
//===============================================================================================//
function cacheElements() {
	elements = {
		username: document.getElementById('username-input'),
		password: document.getElementById('password-input'),
		confirmedPassword: document.getElementById('confirmed-password-input'),
		invitationToken: document.getElementById('invitation-token-input'),
		registerError: document.getElementById('register-error'),
		registerForm: document.getElementById('register-form')
	};
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.username.addEventListener('input', handleUsernameInput);
	elements.password.addEventListener('input', handlePasswordInput);
	elements.confirmedPassword.addEventListener('input', handleConfirmedPasswordInput);
	elements.invitationToken.addEventListener('input', handleInvitationTokenInput);
	elements.registerForm.addEventListener('submit', handleRegisterSubmit);
}
//===============================================================================================//
function handleUsernameInput() {
	clearError();
	
	validateUsername(elements.username);
}
//-----------------------------------------------------------------------------------------------//
function handlePasswordInput() {
	clearError();
	
	validatePassword(elements.password);
}
//-----------------------------------------------------------------------------------------------//
function handleConfirmedPasswordInput() {
	clearError();
	
	if (elements.password.value !== elements.confirmedPassword.value) {
		elements.confirmedPassword.setCustomValidity('De wachtwoorden komen niet overeen.');
	} else {
		elements.confirmedPassword.setCustomValidity('');
	}
}
//-----------------------------------------------------------------------------------------------//
function handleInvitationTokenInput() {
	clearError();

	const rawCursorPos = getRawCursorPosition();
	elements.invitationToken.value = formatInvitationToken(elements.invitationToken.value);
	restoreCursorPosition(rawCursorPos);
	
	validateInvitationToken(elements.invitationToken);
}
//-----------------------------------------------------------------------------------------------//
function handleRegisterSubmit(event) {
	if (!elements.registerForm.checkValidity()) {
		event.preventDefault();
		elements.registerForm.reportValidity();
	}
}
//===============================================================================================//
function clearError() {
	elements.registerError.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
function getRawCursorPosition() {
	return elements.invitationToken.value
		.slice(0, elements.invitationToken.selectionStart)
		.replace(/[^A-Z0-9]/gi, '')
		.length;
}
//-----------------------------------------------------------------------------------------------//
function formatInvitationToken(token) {
    const raw = token
		.replace(/[^A-Za-z0-9]/g, '')
		.toUpperCase()
		.slice(0, 16);

	return raw.match(/.{1,4}/g)?.join('-') ?? '';
}
//-----------------------------------------------------------------------------------------------//
function restoreCursorPosition(rawCursorPos) {
	let count = 0;
	let cursor = elements.invitationToken.value.length;
	for (let i = 0; i < elements.invitationToken.value.length; i++) {
		if (/[A-Z0-9]/.test(elements.invitationToken.value[i])) {
			count++;
		}
		if (count === rawCursorPos) {
			cursor = i + 1;
			break;
		}
	}

	elements.invitationToken.setSelectionRange(cursor, cursor);
}
//-----------------------------------------------------------------------------------------------//
</script>