{{#block "title"}}Inschrijven{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Inschrijven</h1>

<form id="register-form" 
	  method="POST" action="/account/register">
	<div class="mt-md stack">
		<div>
			<label for="username-input" class="form-label">
				Gebruikersnaam:
			</label>
			<input id="username-input" class="form-control" type="text" 
				   name="username" value="{{username}}" required>
		</div>
		
		<div>
			<label for="password-input" class="form-label">
				Wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password" 
				   name="password" required>
		</div>
		
		<div>
			<label for="confirmed-password-input" class="form-label">
				Bevestig wachtwoord:
			</label>
			<input id="confirmed-password-input" class="form-control" type="password" 
				   name="confirmedPassword" required>
		</div>
		
		<div>
			<label for="invitation-token-input" class="form-label">
				Uitnodigingscode:
			</label>
			<input id="invitation-token-input" class="form-control" type="text" 
				   name="invitationToken" required>
		</div>
		
		<div id="register-error" class="error">{{registerError}}</div>
	</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Inschrijven</span>
		</button>
	</div>
</form>

<hr>

<div>Reeds lid? <a href="/account/login">Aanmelden</a>.</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { validateUsername } from '/js/username.validation.js';
import { validatePassword } from '/js/password.validation.js';
import { validatePasswordConfirmation } from '/js/password-confirmation.validation.js';
import { validateInvitationToken } from '/js/invitation-token.validation.js';
//-----------------------------------------------------------------------------------------------//
let usernameInput;
let passwordInput;
let confirmedPasswordInput;
let invitationTokenInput;
let registerErrorElement;
let registerForm;
//-----------------------------------------------------------------------------------------------//
function clearError() {
	registerErrorElement.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
function formatInvitationToken(token) {
    const raw = token
		.replace(/[^A-Za-z0-9]/g, '')
		.toUpperCase()
		.slice(0, 16);

	return raw.match(/.{1,4}/g)?.join('-') ?? '';
}
//-----------------------------------------------------------------------------------------------//
function handleUsernameInput() {
	clearError();
	
	validateUsername(usernameInput);
}
//-----------------------------------------------------------------------------------------------//
function handlePasswordInput() {
	clearError();
	
	validatePassword(passwordInput);
}
//-----------------------------------------------------------------------------------------------//
function handleConfirmedPasswordInput() {
	clearError();
	
	validatePasswordConfirmation(passwordInput, confirmedPasswordInput);
}
//-----------------------------------------------------------------------------------------------//
function handleInvitationTokenInput() {
	clearError();

	const rawCursorPos = invitationTokenInput.value
		.slice(0, invitationTokenInput.selectionStart)
		.replace(/[^A-Z0-9]/gi, '')
		.length;
	
	invitationTokenInput.value = formatInvitationToken(invitationTokenInput.value);

	let count = 0;
	let cursor = invitationTokenInput.value.length;
	for (let i = 0; i < invitationTokenInput.value.length; i++) {
		if (/[A-Z0-9]/.test(invitationTokenInput.value[i])) {
			count++;
		}
		if (count === rawCursorPos) {
			cursor = i + 1;
			break;
		}
	}

	invitationTokenInput.setSelectionRange(cursor, cursor);
	
	validateInvitationToken(invitationTokenInput);
}
//-----------------------------------------------------------------------------------------------//
function handleRegisterFormSubmit(event) {
	if (!registerForm.checkValidity()) {
		event.preventDefault();
		registerForm.reportValidity();
	}
}
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	usernameInput = document.getElementById('username-input');
	passwordInput = document.getElementById('password-input');
	confirmedPasswordInput = document.getElementById('confirmed-password-input');
	invitationTokenInput = document.getElementById('invitation-token-input');
	registerErrorElement = document.getElementById('register-error');
	registerForm = document.getElementById('register-form');
	
	usernameInput.addEventListener('input', handleUsernameInput);
	passwordInput.addEventListener('input', handlePasswordInput);
	confirmedPasswordInput.addEventListener('input', handleConfirmedPasswordInput);
	invitationTokenInput.addEventListener('input', handleInvitationTokenInput);
	registerForm.addEventListener('submit', handleRegisterFormSubmit);
});
//-----------------------------------------------------------------------------------------------//
</script>