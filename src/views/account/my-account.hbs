{{#block "title"}}Mijn account{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Mijn account</h1>

<div id="change-account-success" class="mt-md success">{{changeAccountSuccess}}</div>

<div class="mt-md stack">
	<div>
		<label for="username-input" class="form-label">
			Gebruikersnaam:
		</label>
		<div class="input-group">
			<input id="username-input" class="form-control" type="text"
				   value="{{username}}" readonly>
			<a class="btn-edit" href="/account/change-username">✏️</a>
		</div>
	</div>
	
	<div>
		<label for="password-input" class="form-label">
			Wachtwoord:
		</label>
		<div class="input-group">
			<input id="password-input" class="form-control" type="password"
				   value="********" readonly>
			<a class="btn-edit" href="/account/change-password">✏️</a>
		</div>
	</div>
</div>

<div class="mt-lg">
	<button id="open-deregister-window-button" class="btn btn--danger" type="button" 
			data-bs-toggle="modal" data-bs-target="#deregister-window">
		<span class="btn-front">Uitschrijven</span>
	</button>
</div>

<hr>

<a class="btn btn--navigation" href="/game/enter-world">
	<span class="btn-front">Spelen</span>
</a>

<!------------------------------------------------------------------------------------------------>

<div id="deregister-window" class="modal fade" 
	 tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title">Waarschuwing</h2>
				
				<button class="btn-close" type="button" 
						data-bs-dismiss="modal" aria-label="Sluiten"></button>
			</div>
			
			<div class="modal-body modal-body--warning">
				<div class="modal-icon">⚠️</div>
				
				<p class="modal-message">
					Uw account zal onherroepelijk worden verwijderd.
				</p>
			</div>
			
			<div class="modal-footer">
				<form id="deregister-form" 
					  method="POST" action="/account/deregister">
					<button class="btn btn--modal-ok" type="submit">
						<span class="btn-front">Uitschrijven</span>
					</button>
				</form>
				
				<button class="btn btn--modal-cancel" type="button" data-bs-dismiss="modal">
					<span class="btn-front">Annuleren</span>
				</button>
			</div>
		</div>
	</div>
</div>