{{#block "title"}}Mijn account{{/block}}

<!------------------------------------------------------------------------------------------------>

<div class="layout-narrow">
	<h1>Mijn account</h1>
	
	<div class="mt-md stack">
		<div id="change-account-success" class="success">{{changeAccountSuccess}}</div>
	
		<div>
			<label for="username" class="form-label">
				Gebruikersnaam:
			</label>
			<div class="input-group">
				<input id="username" class="form-control" type="text"
					   value="{{username}}" readonly>
				<a class="btn-edit" href="/account/change-username">✏️</a>
			</div>
		</div>
		
		<div>
			<label for="password" class="form-label">
				Wachtwoord:
			</label>
			<div class="input-group">
				<input id="password" class="form-control" type="password"
					   value="********" readonly>
				<a class="btn-edit" href="/account/change-password">✏️</a>
			</div>
		</div>
	</div>
			
	<form id="deregister-form" class="mt-lg"
		  method="POST" action="/account/deregister">
		<button class="btn-danger" type="submit">
			Uitschrijven
		</button>
	</form>
	
	<hr>
	
	<a class="btn-up" href="/game/enter-world">Spelen</a>
</div>

<script type="module">
//-----------------------------------------------------------------------------------------------//
let deregisterForm;
//-----------------------------------------------------------------------------------------------//
function handleDeregisterFormSubmit(event) {	
	if (!confirm('Uw account zal onherroepelijk worden verwijderd. Bent u zeker?')) {
        event.preventDefault();
	}
}
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	deregisterForm = document.getElementById('deregister-form');
	
	deregisterForm.addEventListener('submit', handleDeregisterFormSubmit);
});
//-----------------------------------------------------------------------------------------------//
</script>