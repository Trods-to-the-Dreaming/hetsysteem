{{#block "title"}}Aanmelden{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Aanmelden</h1>

<form id="login-form"
	  method="POST" action="/account/login">
	<div class="mt-md stack">
		<div>
			<label for="username-input" class="form-label">
				Gebruikersnaam:
			</label>
			<input id="username-input" class="form-control" type="text" 
				   name="username" value="{{username}}" required>
		</div>
		
		<div>
			<label for="password-input" class="form-label">
				Wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password" 
				   name="password" required>
		</div>
		
		<div id="login-error" class="error">{{loginError}}</div>
	</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Aanmelden</span>
		</button>
	</div>
</form>

<hr>

<div>Nog geen lid? <a href="/account/register">Inschrijven</a>.</div>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
let usernameInput;
let passwordInput;
let loginErrorElement;
//-----------------------------------------------------------------------------------------------//
function clearError() {
	loginErrorElement.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	usernameInput = document.getElementById('username-input');
	passwordInput = document.getElementById('password-input');
	loginErrorElement = document.getElementById('login-error');
	
	usernameInput.addEventListener('input', clearError);
	passwordInput.addEventListener('input', clearError);
});
//-----------------------------------------------------------------------------------------------//
</script>