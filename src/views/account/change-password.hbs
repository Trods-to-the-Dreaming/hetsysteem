{{#block "title"}}Wachtwoord wijzigen{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Wachtwoord wijzigen</h1>

<form id="change-password-form" 
	  method="POST" action="/account/change-password">
	<div class="mt-md stack">
		<div>
			<label for="password-input" class="form-label">
				Huidig wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password" 
				   name="password" required>
		</div>
		
		<div>
			<label for="new-password-input" class="form-label">
				Nieuw wachtwoord:
			</label>
			<input id="new-password-input" class="form-control" type="password"
				   name="newPassword" required>
		</div>
		
		<div>
			<label for="confirmed-new-password-input" class="form-label">
				Bevestig nieuw wachtwoord:
			</label>
			<input id="confirmed-new-password-input" class="form-control" type="password"
				   name="confirmedNewPassword" required>
		</div>
	</div>
	
	<div id="change-password-error" class="mt-md error">{{changePasswordError}}</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Bewaren</span>
		</button>
	</div>
</form>

<hr>

<a class="btn btn--navigation" href="/account">
	<span class="btn-front">↑ Annuleren</span>
</a>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { validatePassword } from '/js/password.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	cacheElements();
	addEventListeners();
});
//===============================================================================================//
function cacheElements() {
	elements = {
		password: document.getElementById('password-input'),
		newPassword: document.getElementById('new-password-input'),
		confirmedNewPassword: document.getElementById('confirmed-new-password-input'),
		changePasswordError: document.getElementById('change-password-error'),
		changePasswordForm: document.getElementById('change-password-form')
	};
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.password.addEventListener('input', clearError);
	elements.newPassword.addEventListener('input', handleNewPasswordInput);
	elements.confirmedNewPassword.addEventListener('input', handleConfirmedNewPasswordInput);
	elements.changePasswordForm.addEventListener('submit', handleChangePasswordFormSubmit);
}
//===============================================================================================//
function clearError() {
	elements.changePasswordError.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
function handleNewPasswordInput() {
	clearError();
	
	if (elements.newPassword.value === elements.password.value) {
		elements.newPassword.setCustomValidity('Het nieuwe wachtwoord moet anders zijn.');
	} else {
		validatePassword(elements.newPassword);
	}
}
//-----------------------------------------------------------------------------------------------//
function handleConfirmedNewPasswordInput() {
	clearError();
	
	if (elements.newPassword.value !== elements.confirmedNewPassword.value) {
		elements.confirmedNewPassword.setCustomValidity('De wachtwoorden komen niet overeen.');
	} else {
		elements.confirmedNewPassword.setCustomValidity('');
	}
}
//-----------------------------------------------------------------------------------------------//
function handleChangePasswordFormSubmit(event) {
	if (!elements.changePasswordForm.checkValidity()) {
		event.preventDefault();
		elements.changePasswordForm.reportValidity();
	}
}
//-----------------------------------------------------------------------------------------------//
</script>