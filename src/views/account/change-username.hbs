{{#block "title"}}Gebruikersnaam wijzigen{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Gebruikersnaam wijzigen</h1>

<form id="change-username-form" 
	  method="POST" action="/account/change-username">
	<div class="mt-md stack">
		<div>
			<label for="username-input" class="form-label">
				Huidige gebruikersnaam:
			</label>
			<input id="username-input" class="form-control" type="text"
				   value="{{username}}" readonly>
		</div>
		
		<div>
			<label for="new-username-input" class="form-label">
				Nieuwe gebruikersnaam:
			</label>
			<input id="new-username-input" class="form-control" type="text"
				   name="newUsername" value="{{newUsername}}" required>
		</div>
		
		<div>
			<label for="password-input" class="form-label">
				Wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password"
				   name="password" required>
		</div>
	</div>
	
	<div id="change-username-error" class="mt-md error">{{changeUsernameError}}</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Bewaren</span>
		</button>
	</div>
</form>

<hr>

<a class="btn btn--navigation" href="/account">
	<span class="btn-front">↑ Annuleren</span>
</a>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { validateUsername } from '/js/username.validation.js';
//-----------------------------------------------------------------------------------------------//
let elements;
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	cacheElements();
	addEventListeners();
});
//===============================================================================================//
function cacheElements() {
	elements = {
		username: document.getElementById('username-input'),
		newUsername: document.getElementById('new-username-input'),
		password: document.getElementById('password-input'),
		changeUsernameError: document.getElementById('change-username-error'),
		changeUsernameForm: document.getElementById('change-username-form')
	};
}
//-----------------------------------------------------------------------------------------------//
function addEventListeners() {
	elements.newUsername.addEventListener('input', handleNewUsernameInput);
	elements.password.addEventListener('input', clearError);
	elements.changeUsernameForm.addEventListener('submit', handleChangeUsernameFormSubmit);
}
//===============================================================================================//
function handleNewUsernameInput() {
	clearError();
	
	if (elements.newUsername.value === elements.username.value) {
		elements.newUsername.setCustomValidity('De nieuwe gebruikersnaam moet anders zijn.');
	} else {
		validateUsername(elements.newUsername);
	}
}
//-----------------------------------------------------------------------------------------------//
function clearError() {
	elements.changeUsernameError.textContent = '';
}
//-----------------------------------------------------------------------------------------------//

function handleChangeUsernameFormSubmit(event) {	
	if (!elements.changeUsernameForm.checkValidity()) {
		event.preventDefault();
		elements.changeUsernameForm.reportValidity();
	}
}
//-----------------------------------------------------------------------------------------------//
</script>