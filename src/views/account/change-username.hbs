{{#block "title"}}Gebruikersnaam wijzigen{{/block}}

<!------------------------------------------------------------------------------------------------>

<h1>Gebruikersnaam wijzigen</h1>

<form id="change-username-form" 
	  method="POST" action="/account/change-username">
	<div class="mt-md stack">
		<div>
			<label for="username-input" class="form-label">
				Huidige gebruikersnaam:
			</label>
			<input id="username-input" class="form-control" type="text"
				   value="{{username}}" readonly>
		</div>
		
		<div>
			<label for="new-username-input" class="form-label">
				Nieuwe gebruikersnaam:
			</label>
			<input id="new-username-input" class="form-control" type="text"
				   name="newUsername" value="{{newUsername}}" required>
		</div>
		
		<div>
			<label for="password-input" class="form-label">
				Wachtwoord:
			</label>
			<input id="password-input" class="form-control" type="password"
				   name="password" required>
		</div>
		
		<div id="change-username-error" class="error">{{changeUsernameError}}</div>
	</div>
	
	<div class="mt-lg">
		<button class="btn btn--primary" type="submit">
			<span class="btn-front">Bewaren</span>
		</button>
	</div>
</form>

<hr>

<a class="btn btn--navigation" href="/account">
	<span class="btn-front">↑ Annuleren</span>
</a>

<!------------------------------------------------------------------------------------------------>

<script type="module">
//-----------------------------------------------------------------------------------------------//
import { validateUsername } from '/js/username.validation.js';
//-----------------------------------------------------------------------------------------------//
let newUsernameInput;
let passwordInput;
let changeUsernameErrorElement;
let changeUsernameForm;
//-----------------------------------------------------------------------------------------------//
function clearError() {
	changeUsernameErrorElement.textContent = '';
}
//-----------------------------------------------------------------------------------------------//
function handleNewUsernameInput() {
	clearError();
	
	if (newUsernameInput.value === usernameInput.value) {
		newUsernameInput.setCustomValidity('De nieuwe gebruikersnaam moet anders zijn.');
	} else {
		validateUsername(newUsernameInput);
	}
}
//-----------------------------------------------------------------------------------------------//
function handleChangeUsernameFormSubmit(event) {	
	if (!changeUsernameForm.checkValidity()) {
		event.preventDefault();
		changeUsernameForm.reportValidity();
	}
}
//-----------------------------------------------------------------------------------------------//
document.addEventListener('DOMContentLoaded', () => {
	newUsernameInput = document.getElementById('new-username-input');
	passwordInput = document.getElementById('password-input');
	changeUsernameErrorElement = document.getElementById('change-username-error');
	changeUsernameForm = document.getElementById('change-username-form');
	
	newUsernameInput.addEventListener('input', handleNewUsernameInput);
	passwordInput.addEventListener('input', clearError);
	changeUsernameForm.addEventListener('submit', handleChangeUsernameFormSubmit);
});
//-----------------------------------------------------------------------------------------------//
</script>